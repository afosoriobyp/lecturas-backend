# ─── FastAPI ──────────────────────────────
APP_NAME="Lectura Medidor API"
APP_VERSION="0.2.0"
APP_DEBUG=false
API_PREFIX=

# ─── PostgreSQL (async) ───────────────────
# Opción A: URL directa (Render, Supabase, etc.)
DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/nombre_db

# Opción B: Componentes individuales
# POSTGRES_USER=<tu-usuario>
# POSTGRES_PASSWORD=<tu-password>
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=<tu-base-de-datos>

# Pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_STATEMENT_TIMEOUT_MS=10000

# ─── JWT ──────────────────────────────────
JWT_SECRET_KEY=generar-clave-segura-aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=lax

# ─── CORS (lista separada por comas) ──────
CORS_ORIGINS=["https://tudominio-frontend.com"]

# ─── Uploads ──────────────────────────────
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
MAX_FOTOS_PER_LECTURA=5

# ─── Telegram (opcional) ──────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ─── Logging ──────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
